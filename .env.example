# Copy this file to .env and fill in your own values.
# Never commit .env to version control.

# Full PostgreSQL connection string.
# Local example:   postgres://postgres:password@localhost:5432/backend_learn
# Railway example: postgresql://postgres:xxxx@containers-us-west-xx.railway.app:6543/railway
DATABASE_URL=postgres://user:password@localhost:5432/backend_learn

# Set to "false" to disable SSL for a local Postgres instance.
# Leave unset (or set to anything other than "false") for cloud DBs that require SSL.
DATABASE_SSL=false
